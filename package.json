{
  "name": "editer-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/node": "^22.14.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @editer/ui build && node scripts/sync-ui.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --filter './packages/*' typecheck && pnpm --filter @editer/ui typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "editer": "pnpm --filter @editer/cli start",
    "install:global": "node scripts/install-global.mjs",
    "editer:bin": "node packages/cli/dist/index.js"
  }
}
